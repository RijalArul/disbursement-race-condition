APP_PORT=8080
APP_ENV=development

# Dibaca aplikasi lewat config.Load().
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=disbursement
DB_SSLMODE=disable
# Hanya dipakai target `make migrate-up` / `make migrate-down` (golang-migrate),
# bukan oleh aplikasi. Nilainya harus menunjuk database yang sama seperti DB_* di atas.
DATABASE_URL=postgres://postgres:postgres@localhost:5434/disbursement?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

AUDIT_WORKER_COUNT=4
AUDIT_BUFFER_SIZE=1024

RATE_LIMIT_CREATE=30
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_LOGIN_IP=10
RATE_LIMIT_LOGIN_USERNAME=5

LOG_LEVEL=info
