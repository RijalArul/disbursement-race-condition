        "/disbursements": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "disbursements"
                ],
                "summary": "List disbursements",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Page number, default 1",
                        "name": "page",
                        "in": "query"
                    },
                    {
                        "type": "integer",
                        "description": "Page size, default 20, max 100",
                        "name": "limit",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Matches recipient_name or account_number",
                        "name": "search",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "PENDING, APPROVED, or REJECTED",
                        "name": "status",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "RFC3339 lower bound on created_at",
                        "name": "date_from",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "RFC3339 upper bound on created_at",
                        "name": "date_to",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "Whitelisted column, e.g. created_at, amount",
                        "name": "sort_by",
                        "in": "query"
                    },
                    {
                        "type": "string",
                        "description": "asc or desc",
                        "name": "sort_order",
                        "in": "query"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/definitions/disbursement.Response"
                                            }
                                        },
                                        "meta": {
                                            "$ref": "#/definitions/response.PageMeta"
                                        }
                                    }
                                }
                            ]
                        },
                        "headers": {
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request correlation ID; echoed from the request header or generated if absent"
                            }
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR: sort_by/sort_order not in whitelist, or invalid date",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "disbursements"
                ],
                "summary": "Create disbursement",
                "parameters": [
                    {
                        "type": "string",
                        "description": "UUID; a retried request with the same key and body within 24h replays the first response",
                        "name": "Idempotency-Key",
                        "in": "header"
                    },
                    {
                        "description": "Disbursement details",
                        "name": "request",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/disbursement.CreateRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "allOf": [
                                {
                                    "$ref": "#/definitions/response.Envelope"
                                },
                                {
                                    "type": "object",
                                    "properties": {
                                        "data": {
                                            "$ref": "#/definitions/disbursement.Response"
                                        }
                                    }
                                }
                            ]
                        },
                        "headers": {
                            "X-Idempotent-Replayed": {
                                "type": "string",
                                "description": "true when this response is a replay of an earlier request with the same Idempotency-Key"
                            },
                            "X-Request-ID": {
                                "type": "string",
                                "description": "Request correlation ID; echoed from the request header or generated if absent"
                            }
                        }
                    },
                    "400": {
                        "description": "VALIDATION_ERROR: missing field or amount below minimum",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    },
                    "401": {
                        "description": "UNAUTHORIZED: missing or invalid access token",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    },
                    "409": {
                        "description": "IDEMPOTENCY_IN_PROGRESS: a request with this key is still processing",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    },
                    "422": {
                        "description": "IDEMPOTENCY_KEY_REUSED: same key, different request body",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    },
                    "429": {
                        "description": "RATE_LIMITED",
                        "schema": {
                            "$ref": "#/definitions/response.Envelope"
                        }
                    }
                }
            }
        },
        "/disbursements/{id}": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
